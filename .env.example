# Copy to .env and fill in. .env is gitignored.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=footpedia
DB_USER=footpedia
DB_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Providers ---
# https://www.football-data.org/client/register  (free: 10 req/min)
FOOTBALL_DATA_API_KEY=
# https://www.api-football.com/  (free: 100 req/DAY)
API_FOOTBALL_API_KEY=

# --- AI agent ---
ANTHROPIC_API_KEY=

# --- Telegram bot (reminders + agent interface) ---
TELEGRAM_BOT_TOKEN=
