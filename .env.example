# Copy to .env and fill in. .env is gitignored.

# --- Database (Supabase Postgres) ---
# Project Settings -> Database -> Connection string. Use the direct connection
# or the session pooler (port 5432) -- NOT the transaction pooler (6543), which
# breaks Hibernate's prepared statement caching.
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Providers ---
# https://www.football-data.org/client/register  (free: 10 req/min)
FOOTBALL_DATA_API_KEY=
# https://www.api-football.com/  (free: 100 req/DAY)
API_FOOTBALL_API_KEY=

# --- AI agent ---
ANTHROPIC_API_KEY=

# --- Telegram bot (reminders + agent interface) ---
TELEGRAM_BOT_TOKEN=

# --- Our own API auth (JWT) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# --- Password reset email (Gmail SMTP) ---
# 1. Enable 2-Step Verification on the Gmail account: myaccount.google.com/security
# 2. Create an App Password: myaccount.google.com/apppasswords (app: Mail)
# 3. Use that 16-char app password below -- NOT the regular Gmail password.
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=
# Where the reset link in the email points -- footpedia-fe's dev server.
FRONTEND_URL=http://localhost:5173

# --- CORS ---
# Must match footpedia-fe's origin exactly (scheme + host + port).
FRONTEND_ORIGIN=http://localhost:5173
